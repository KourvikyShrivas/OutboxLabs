# ---------- Server ----------
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Run the BullMQ worker inside the API process (true = one command runs everything).
# Set to false if you run `npm run worker` as a separate process.
RUN_WORKER=true

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- Queue behaviour ----------
QUEUE_NAME=email-scheduler
# Default number of attempts per email (1 = no retries)
JOB_ATTEMPTS=3
# Exponential backoff base delay: waits 5s, 10s, 20s, ...
JOB_BACKOFF_DELAY_MS=5000
WORKER_CONCURRENCY=5

# ---------- Ethereal SMTP (fake inbox, free) ----------
# Leave SMTP_USER / SMTP_PASS EMPTY and the server auto-creates a free Ethereal
# account on startup and prints the inbox login in the terminal.
# To reuse one inbox across restarts, paste those printed credentials here.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=ReachInbox <no-reply@reachinbox.local>
